APP_ENV=local

# =============================================================================
# Chat 大模型（Agent 对话 / QA 异步分类）
# =============================================================================
# Chat 模型 API Key（必填）
OPENAI_API_KEY=sk-xxx
# 可选：覆盖聊天模型的 OpenAI 兼容网关地址
# AI_CHAT_MODEL_BASE_URL=https://your-proxy/v1
# 可选：覆盖聊天模型名称
# AI_CHAT_MODEL_MODEL_NAME=gpt-4o

# =============================================================================
# Embedding 向量化模型（独立于 Chat）
# =============================================================================
# 向量化模型 API Key。推荐使用新变量名。
# EMBEDDING_API_KEY=sk-xxx
# 兼容旧变量名（若填这个也能生效）
OPENAI_EMBEDDING_API_KEY=sk-xxx
# 可选：覆盖 embedding 网关地址（可与 Chat 不同）
# EMBEDDING_BASE_URL=https://your-embedding-proxy/v1
# 可选：覆盖 embedding 模型名称
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# 可选：embedding provider，可选 openai | ark | ark_multimodal。ark 为火山方舟。
# EMBEDDING_PROVIDER=openai
# 火山方舟示例：
# EMBEDDING_PROVIDER=ark
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_MODEL_NAME=your-ark-model-or-endpoint-id
# EMBEDDING_DIMENSIONS=2048
# 若使用火山多模态向量化接口 /embeddings/multimodal：
# EMBEDDING_PROVIDER=ark_multimodal

# =============================================================================
# Redis 基础设施
# 用途：分类队列 / HITL checkpoint；若 vector_store=redissearch 也兼作向量库
# =============================================================================
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=

# =============================================================================
# 向量库切换
# =============================================================================
# 可选值：redissearch | milvus
# VECTOR_STORE_PROVIDER=redissearch

# --- Milvus / Zilliz Cloud ---
# 本地或自建 Milvus 地址，例如 localhost:19530
# MILVUS_ADDRESS=localhost:19530
# 云端 Zilliz/Milvus URL，可填 https://xxx:443
# MILVUS_URI=
# 云端 Token 或鉴权 token
# MILVUS_TOKEN=

# =============================================================================
# 业务库（SQLite / MySQL）
# =============================================================================
# DATABASE_DRIVER=sqlite
# DATABASE_SQLITE_PATH=./data/app.db
# DATABASE_DRIVER=mysql
# DATABASE_MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/agent_cs?parseTime=true&charset=utf8mb4&loc=Local

# =============================================================================
# GM Admin
# =============================================================================
# JWT_SECRET=change-me
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# External GM console compatibility API. Use a long random value in production.
# GM_INTEGRATION_KEY=change-me
