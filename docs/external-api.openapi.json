{
  "openapi": "3.0.3",
  "info": {"title": "客服对外 Biz API", "version": "1.0.0", "description": "客服会话及问答接口。Idempotency-Key 和 client_message_id 当前不提供服务端去重。"},
  "servers": [{"url": "http://localhost:8080"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/v1/biz/auth/public-token": {"post": {"security": [], "tags": ["Auth"], "summary": "公开控件申请短期 Token", "description": "按公开渠道、Origin 和客户端 IP 签发约 15 分钟有效的 Token，并执行每分钟限制与每日配额。", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublicTokenRequest"}}}}, "responses": {"200": {"description": "成功"}, "403": {"$ref": "#/components/responses/Unauthorized"}, "429": {"$ref": "#/components/responses/TooManyRequests"}, "503": {"$ref": "#/components/responses/ServiceUnavailable"}}}},
    "/api/v1/biz/sessions": {"post": {"tags": ["Sessions"], "summary": "创建会话", "parameters": [{"$ref": "#/components/parameters/CallerUser"}, {"$ref": "#/components/parameters/Channel"}, {"$ref": "#/components/parameters/Tenant"}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSessionRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Session"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/api/v1/biz/sessions/{id}": {"parameters": [{"$ref": "#/components/parameters/SessionID"}], "get": {"tags": ["Sessions"], "summary": "获取会话信息", "responses": {"200": {"$ref": "#/components/responses/Session"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "delete": {"tags": ["Sessions"], "summary": "关闭会话", "responses": {"200": {"$ref": "#/components/responses/DeleteSession"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/biz/sessions/{id}/history": {"get": {"tags": ["Sessions"], "summary": "获取会话历史", "parameters": [{"$ref": "#/components/parameters/SessionID"}], "responses": {"200": {"$ref": "#/components/responses/History"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/biz/users/{callerUserID}/sessions": {"get": {"tags": ["Sessions"], "summary": "查询用户历史会话", "parameters": [{"name": "callerUserID", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}}, {"name": "size", "in": "query", "schema": {"type": "integer", "default": 20}}, {"name": "channel_id", "in": "query", "schema": {"type": "string"}}, {"name": "tenant_id", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"$ref": "#/components/responses/SessionList"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/biz/sessions/{id}/chat": {"post": {"tags": ["Chat"], "summary": "会话内流式问答", "description": "成功时返回 Server-Sent Events。", "parameters": [{"$ref": "#/components/parameters/SessionID"}, {"$ref": "#/components/parameters/RequestID"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChatRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/SSE"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"}, "503": {"$ref": "#/components/responses/ServiceUnavailable"}}}},
    "/api/v1/biz/sessions/{id}/approve": {"post": {"tags": ["Chat"], "summary": "人工确认后恢复执行", "description": "成功时返回 Server-Sent Events。", "parameters": [{"$ref": "#/components/parameters/SessionID"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApprovalRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/SSE"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/api/v1/biz/chat/ask": {"post": {"tags": ["Chat"], "summary": "无状态问答", "parameters": [{"$ref": "#/components/parameters/CallerUser"}, {"$ref": "#/components/parameters/Channel"}, {"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/RequestID"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AskRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Ask"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/ServiceUnavailable"}}}}
  },
  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "caller token", "description": "推荐方式；也支持 X-Caller-Token，二者同时提供时后者优先。"}, "CallerToken": {"type": "apiKey", "in": "header", "name": "X-Caller-Token"}},
    "parameters": {"SessionID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "CallerUser": {"name": "X-Caller-User-Id", "in": "header", "schema": {"type": "string"}}, "Channel": {"name": "X-Channel-Id", "in": "header", "schema": {"type": "string"}}, "Tenant": {"name": "X-Tenant-Id", "in": "header", "schema": {"type": "string"}}, "RequestID": {"name": "X-Request-ID", "in": "header", "schema": {"type": "string"}}, "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "description": "仅记录、不去重。", "schema": {"type": "string"}}},
    "schemas": {
      "Envelope": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "integer"}, "message": {"type": "string"}, "data": {}}}, "Error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "integer"}, "message": {"type": "string"}}},
      "Session": {"type": "object", "properties": {"id": {"type": "string", "format": "uuid"}, "title": {"type": "string"}, "external_user_id": {"type": "string"}, "channel_id": {"type": "string"}, "tenant_id": {"type": "string"}, "caller_token_id": {"type": "string", "format": "uuid"}, "status": {"type": "string"}, "meta": {"type": "object", "additionalProperties": true}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "closed_at": {"type": "string", "format": "date-time", "nullable": true}}},
      "PublicTokenRequest": {"type": "object", "required": ["channel_id", "caller_user_id"], "properties": {"channel_id": {"type": "string"}, "caller_user_id": {"type": "string"}}},
      "CreateSessionRequest": {"type": "object", "properties": {"caller_user_id": {"type": "string"}, "channel_id": {"type": "string"}, "tenant_id": {"type": "string"}, "meta": {"type": "object", "additionalProperties": true}}}, "ChatRequest": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string", "minLength": 1}, "client_message_id": {"type": "string", "description": "当前不去重。"}}}, "ApprovalRequest": {"type": "object", "required": ["interrupt_id"], "properties": {"interrupt_id": {"type": "string"}, "approved": {"type": "boolean"}}},
      "HistoryInput": {"type": "object", "required": ["role", "content"], "properties": {"role": {"type": "string", "enum": ["user", "assistant", "system"]}, "content": {"type": "string"}}}, "AskRequest": {"type": "object", "required": ["question"], "properties": {"question": {"type": "string", "minLength": 1}, "caller_user_id": {"type": "string"}, "channel_id": {"type": "string"}, "tenant_id": {"type": "string"}, "client_message_id": {"type": "string"}, "history": {"type": "array", "items": {"$ref": "#/components/schemas/HistoryInput"}}, "meta": {"type": "object", "additionalProperties": true}}},
      "Message": {"type": "object", "properties": {"id": {"type": "string", "format": "uuid"}, "role": {"type": "string"}, "content": {"type": "string"}, "request_id": {"type": "string"}, "client_message_id": {"type": "string"}, "extra": {"type": "object", "additionalProperties": true}, "created_at": {"type": "string", "format": "date-time"}}}
    },
    "responses": {"BadRequest": {"description": "请求参数错误", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "Unauthorized": {"description": "caller token 缺失或无效", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "NotFound": {"description": "会话不存在", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "TooManyRequests": {"description": "触发限流", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "ServiceUnavailable": {"description": "模型未配置", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "Session": {"description": "成功", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Envelope"}, {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Session"}}}]}}}}, "DeleteSession": {"description": "成功", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}}}}, "History": {"description": "成功", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}}}}, "SessionList": {"description": "成功", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}}}}, "Ask": {"description": "成功", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}}}}, "SSE": {"description": "SSE 事件流", "content": {"text/event-stream": {"schema": {"type": "string", "example": "data: {\\\"type\\\":\\\"stream_chunk\\\",\\\"content\\\":\\\"您好\\\"}\\n\\ndata: {\\\"type\\\":\\\"action\\\",\\\"action_type\\\":\\\"exit\\\"}\\n\\n"}}}}}}
  }
